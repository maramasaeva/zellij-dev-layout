layout {
    // Default working directory for every pane; panes below only
    // set cwd when they need something else.
    cwd "~"

    // Add tab-bar at top and status-bar at bottom
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="messier" focus=true {
        pane split_direction="vertical" {
            pane
            pane split_direction="horizontal" {
                pane
                pane
            }
        }
    }

    tab name="mara" {
        pane split_direction="vertical" {
            pane
            pane
        }
    }

    tab name="test" {
        pane split_direction="horizontal" {
            pane {
                cwd "~/Documents/Cursor/chatgpt-connectors/chatgpt-connectors"
            }
            pane {
                cwd "~/Documents/Cursor/chatgpt-connectors/chatgpt-connectors"
            }
        }
    }

    tab name="voice" {
        pane {
            cwd "~/Desktop"
        }
    }

    tab name="scratch" {
        pane {
            cwd "~/Documents/Cursor"
        }
    }
}
