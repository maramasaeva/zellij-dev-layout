layout {
    // Default working directory for every pane. Change it, or override
    // per pane with its own cwd (see the "test" tab below).
    cwd "~"

    // Tab bar at top, status bar at bottom, on every tab
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // ── TABS ──────────────────────────────────────────────────────
    // To rename a tab, just edit the name="..." value on its line.

    // Main workspace: one big pane on the left, two stacked on the right
    tab name="messier" focus=true {
        pane split_direction="vertical" {
            pane
            pane split_direction="horizontal" {
                pane
                pane
            }
        }
    }

    // Two panes side by side
    tab name="mara" {
        pane split_direction="vertical" {
            pane
            pane
        }
    }

    // Two panes stacked. To open a tab in a project directory,
    // give its panes a cwd, e.g.:
    //     pane {
    //         cwd "~/code/my-project"
    //     }
    tab name="test" {
        pane split_direction="horizontal" {
            pane
            pane
        }
    }

    // Single-pane tabs
    tab name="voice" {
        pane
    }

    tab name="scratch" {
        pane
    }
}
